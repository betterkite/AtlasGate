# Server
ATLASGATE_HOST=127.0.0.1
ATLASGATE_PORT=4310
ATLASGATE_DB_PATH=./data/atlasgate.db
ATLASGATE_DEV_MODE=true
ATLASGATE_DEV_KEY=replace-for-local-development
ATLASGATE_REQUEST_TIMEOUT_MS=60000

# Persistent Python Agent worker pool
ATLASGATE_PYTHON=python
ATLASGATE_PYTHON_TIMEOUT_MS=15000
ATLASGATE_PYTHON_WORKER_POOL_SIZE=2
ATLASGATE_PYTHON_WORKER_QUEUE_LIMIT=100
ATLASGATE_PYTHON_WORKER_MAX_REQUESTS=1000

# Retrieval: local is offline BM25 + feature vector; qdrant requires all settings below
ATLASGATE_RETRIEVAL_MODE=local
ATLASGATE_EMBEDDING_BASE_URL=
ATLASGATE_EMBEDDING_API_KEY=
ATLASGATE_EMBEDDING_MODEL=
ATLASGATE_EMBEDDING_DIMENSIONS=0
ATLASGATE_QDRANT_URL=http://qdrant:6333
ATLASGATE_QDRANT_API_KEY=
ATLASGATE_QDRANT_COLLECTION_PREFIX=atlasgate
